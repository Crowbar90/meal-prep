<Project Sdk="Aspire.AppHost.Sdk/13.4.6">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!--
    Keep the Aspire.AppHost.Sdk version (in the Sdk attribute above) and the
    Aspire.Hosting.AppHost package version in lockstep. They ship together
    and must move together.
  -->
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.4.6" />
  </ItemGroup>

  <ItemGroup>
    <!--
      No ProjectReferences today. The AppHost orchestrates nothing yet; once a
      runnable service project lands (e.g. MealPrepPlanner.Api), reference it
      here so the Aspire SDK generates a strongly-typed
      Projects.MealPrepPlanner_Api reference and the AppHost can call
      builder.AddProject<Projects.MealPrepPlanner_Api>(...).
    -->
  </ItemGroup>

</Project>